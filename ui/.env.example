# Frontend env — no secrets committed (Twelve-factor). Real values injected at deploy.
# Base URL of the FastAPI backend. The frontend only ever talks to REST here.
VITE_API_BASE_URL=/api/v1
# When "true", the services layer resolves mock payloads so the UI runs without
# a backend. Set "false" to hit the real API.
VITE_USE_MOCKS=true

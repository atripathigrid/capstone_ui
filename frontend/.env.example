# Frontend env (no secrets committed — real values injected at deploy).
# Base URL for the FastAPI backend. The browser only ever talks to this REST
# API; it has no DB client / connection string.
VITE_API_BASE_URL=/api

# When true the app resolves the documented mock payloads instead of hitting
# the live backend (useful before the backend is stood up).
VITE_USE_MOCK_API=true

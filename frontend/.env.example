# Base URL of the FastAPI backend the service layer calls.
# The frontend NEVER talks to a database directly (see plan Requirement 5).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# When "1", the service layer resolves against an in-memory mock instead of the
# network, so the UI is fully runnable with no backend present.
VITE_USE_MOCK_API=1
